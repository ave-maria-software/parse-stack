#!/usr/bin/env ruby
# frozen_string_literal: true

# Credential guard.
#
# Compares candidate tokens against .secret-hashes — a list of SHA256 digests
# of credentials that must never enter this repository. The digests reveal
# nothing by themselves; the values they protect generally cannot be rotated,
# which makes a leak irreversible.
#
# Every added line is tokenized (>= 20 chars of base64-ish alphabet), each
# token is hashed and looked up. On a match the script aborts naming only the
# file/line — never the value.
#
# Modes:
#   bin/check_no_secrets --staged          # pre-commit: staged diff
#   bin/check_no_secrets --range A..B      # CI/publisher: every commit in range
#   bin/check_no_secrets --all-history     # first publication: every blob

require 'digest'

HASHES_FILE = File.join(__dir__, '..', '.secret-hashes')
abort 'missing .secret-hashes' unless File.exist?(HASHES_FILE)
FORBIDDEN = File.readlines(HASHES_FILE).map(&:strip).reject(&:empty?).to_a
TOKEN_RE = /[A-Za-z0-9+\/=_-]{20,}/

def scan_lines(lines_with_origin)
  hits = []
  lines_with_origin.each do |origin, line|
    line.scan(TOKEN_RE).each do |tok|
      hits << origin if FORBIDDEN.include?(Digest::SHA256.hexdigest(tok))
    end
  end
  hits.uniq
end

def added_lines_from_diff(diff_cmd)
  origin = 'unknown'
  out = []
  # Binary read + scrub: diffs can carry UTF-8 or binary content while the
  # hook environment may default to US-ASCII — without this the guard itself
  # would crash on perfectly normal content.
  IO.popen(diff_cmd, external_encoding: Encoding::BINARY) do |io|
    io.each_line do |raw|
      l = raw.force_encoding(Encoding::UTF_8).scrub
      origin = Regexp.last_match(1) if l =~ /^\+\+\+ b\/(.*)$/
      out << [origin, l[1..]] if l.start_with?('+') && !l.start_with?('+++')
    end
  end
  out
end

mode = ARGV[0] || '--staged'
lines =
  case mode
  when '--staged'      then added_lines_from_diff(%w[git diff --cached --unified=0])
  when '--range'       then added_lines_from_diff(['git', 'diff', '--unified=0', ARGV[1] || abort('--range needs A..B')])
  when '--all-history' then
    blobs = `git rev-list --all --objects`.lines.map { |l| l.split.first }.uniq
    blobs.flat_map do |sha|
      type = `git cat-file -t #{sha} 2>/dev/null`.strip
      next [] unless type == 'blob'
      content = `git cat-file blob #{sha} 2>/dev/null`.force_encoding(Encoding::UTF_8).scrub
      content.lines.map { |l| ["blob #{sha[0, 10]}", l] }
    end
  else abort "unknown mode: #{mode}"
  end

hits = scan_lines(lines)
if hits.empty?
  puts "check_no_secrets OK (#{mode}, #{lines.size} lines scanned)"
else
  warn '=============================================================='
  warn 'SECRET DETECTED — content matches a forbidden credential hash.'
  warn 'These credentials cannot be rotated. DO NOT COMMIT / PUBLISH.'
  hits.each { |h| warn "   at: #{h}" }
  warn '=============================================================='
  exit 1
end
